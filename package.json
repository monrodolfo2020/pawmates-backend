{
  "name": "pawmates-backend",
  "version": "0.0.1",
  "description": "PawMates backend — 14 Bounded-Context services (NestJS monorepo). booking-svc is fully implemented; the rest are functional skeletons. See README.md.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "node scripts/build-all.js",
    "build:booking-svc": "nest build booking-svc",
    "build:commerce-svc": "nest build commerce-svc",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start:booking-svc": "nest start booking-svc",
    "start:booking-svc:dev": "nest start booking-svc --watch",
    "start:commerce-svc": "nest start commerce-svc",
    "start:commerce-svc:dev": "nest start commerce-svc --watch",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "migration:run:booking-svc": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d apps/booking-svc/src/infra/persistence/data-source.ts",
    "migration:run:commerce-svc": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d apps/commerce-svc/src/infra/persistence/data-source.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.2",
    "kafkajs": "^2.2.4",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testRegex": "(apps|libs)/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@pawmates/common$": "<rootDir>/libs/common/src",
      "^@pawmates/common/(.*)$": "<rootDir>/libs/common/src/$1",
      "^@pawmates/proto$": "<rootDir>/libs/proto/src",
      "^@pawmates/proto/(.*)$": "<rootDir>/libs/proto/src/$1"
    },
    "collectCoverageFrom": ["apps/**/*.(t|j)s", "libs/**/*.(t|j)s"],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
