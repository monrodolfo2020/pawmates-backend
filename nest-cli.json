{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/pawmates-api/src",
  "monorepo": true,
  "root": "apps/pawmates-api",
  "compilerOptions": {
    "webpack": false,
    "tsConfigPath": "apps/pawmates-api/tsconfig.app.json",
    "deleteOutDir": true
  },
  "projects": {
    "pawmates-api": {
      "type": "application",
      "root": "apps/pawmates-api",
      "entryFile": "main",
      "sourceRoot": "apps/pawmates-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/pawmates-api/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    }
  }
}
