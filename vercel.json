{
  "buildCommand": "npm run build && npm run migration:run:pawmates-api",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "node_modules/@libsql/**"
    }
  },
  "crons": [
    {
      "path": "/v1/cron/trial-reminders",
      "schedule": "0 15 * * *"
    }
  ]
}
