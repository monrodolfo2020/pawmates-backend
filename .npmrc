# The `libsql` package (aliased in package.json as `better-sqlite3`, see
# infra/persistence/libsql-connection.ts) exposes a slightly different
# version number than TypeORM's `better-sqlite3` peerOptional range
# expects — harmless here since the alias only needs API compatibility,
# not the exact declared semver, but npm's default strict peer resolution
# would otherwise refuse to install at all.
legacy-peer-deps=true
